{
  "_comment": "Registry for -Suite Extended. kind 'editor': runs start (C# statement) through the Unity CLI with Play stopped, then waits for report (path relative to the project root, must be rewritten and contain passed=true). kind 'python': runs script with args; passes on exit code 0 and, when report is set, passed=true. Add an entry here to register a new verifier; no runner change is needed. Timeouts in seconds.",
  "verifiers": [
    { "name": "Bridge integration", "kind": "editor", "start": "Game.Editor.Verification.RunAll();return true;", "report": "Verification/unity-checks.json", "timeout": 120 },
    { "name": "Workshop chain", "kind": "editor", "start": "Game.Editor.WorkshopChainVerification.StartVerification();return true;", "report": "Verification/workshop-chain-unity-checks.json", "timeout": 240 },
    { "name": "Runtime actor", "kind": "editor", "start": "Game.Editor.RuntimeActorVerification.Start();return true;", "report": "Verification/runtime-actor-checks.json", "timeout": 240 },
    { "name": "Runtime experience", "kind": "editor", "start": "Game.Editor.RuntimeExperienceVerification.Start();return true;", "report": "Verification/runtime-experience-checks.json", "timeout": 240 },
    { "name": "Runtime spatial", "kind": "editor", "start": "Game.Editor.RuntimeSpatialVerification.Start();return true;", "report": "Verification/runtime-spatial-checks.json", "timeout": 240 },
    { "name": "Photo object", "kind": "editor", "start": "Game.Editor.PhotoObjectVerification.Run();return true;", "report": "Verification/photo-object-checks.json", "timeout": 120 },
    { "name": "Chat loop (no providers)", "kind": "editor", "start": "Game.Editor.ChatLoopVerification.Start();return true;", "report": "Verification/chat-loop-checks.json", "timeout": 180 },
    { "name": "Native smoke", "kind": "python", "script": "Verification/native_smoke.py", "args": [], "report": "Verification/native-checks.json", "timeout": 120 },
    { "name": "Capability native smoke", "kind": "python", "script": "Verification/capability_native_smoke.py", "args": ["Assets/Plugins/Flecs/x86_64/flecs_unity.dll"], "report": "Verification/capability-native-checks.json", "timeout": 120 },
    { "name": "Runtime engine native smoke", "kind": "python", "script": "Verification/runtime_engine_smoke.py", "args": [], "report": "Verification/runtime-engine-native-checks.json", "timeout": 120 },
    { "name": "Runtime behavior native smoke", "kind": "python", "script": "Verification/runtime_behavior_smoke.py", "args": [], "report": "Verification/runtime-behavior-native-checks.json", "timeout": 120 },
    { "name": "Workshop chain native smoke", "kind": "python", "script": "Verification/workshop_chain_smoke.py", "args": [], "report": "", "timeout": 120 },
    { "name": "Native contract checks", "kind": "python", "script": "Verification/contract_checks.py", "args": [], "report": "Verification/contract-checks.json", "timeout": 120 },
    { "name": "Engine benchmark budgets", "kind": "python", "script": "Verification/bench_engine.py", "args": [], "report": "Verification/engine-bench.json", "timeout": 240 }
  ]
}
