    {
      "path": "World",
      "code": "// Reusable empty diorama. GroundSurface requests a static collision surface.\r\nGroundSurface {}\r\ndiorama {\r\n    Position: {0,0,0}\r\n    Ground {\r\n        GroundSurface\r\n        Position: {0,-0.2,0}\r\n        Scale: {16,0.4,16}\r\n        Primitive: {kind: 0}\r\n        Color: {0.23,0.32,0.30,1}\r\n    }\r\n}\r\n\r\nWorldSeed {\r\n    Position: {0,0.62,0}\r\n    Primitive: {kind: -1}\r\n}\r\n"
    },
    {
      "path": "ActorSchema",
      "code": "// Runtime protocol shared by inputs, behavior rules and Unity motor adapters.\r\nstruct ActorControl(mode: i32, speed: f32, acceleration: f32)\r\nstruct MoveIntent(x: f32, z: f32)\r\nstruct ActorMotion(x: f32, y: f32, z: f32, yaw: f32, vx: f32, vy: f32, vz: f32, grounded: bool)\r\nstruct ActorRig(json: string)\r\nstruct PlayerMotion(x: f32, z: f32)\r\nstruct MoveGoal(x: f32, z: f32, stopDistance: f32)\r\nInput { PlayerMotion: {0,0} }\r\nGoal { MoveGoal: {3,2,0.25} }\r\n\r\nScriptInput { MoveIntent: {0,0} }\r\n\r\n// Generic three-dimensional steering, with no aircraft-specific behavior.\r\nstruct SpatialIntent(x: f32, y: f32, z: f32)\r\nstruct MotorPolicy(spatial: bool, gravityScale: f32)\r\nstruct LiftIntent(y: f32)\r\nInput { LiftIntent: {0} }\r\nScriptInput { SpatialIntent: {0,0,0} }\r\n"
    },
    {
      "path": "ClayBrushSchema",
      "code": "struct ClayRest(px: f32, py: f32, pz: f32, rx: f32, ry: f32, rz: f32, sx: f32, sy: f32, sz: f32)\r\nstruct ClayStyle(kind: i32, r: f32, g: f32, b: f32, metallic: f32, smoothness: f32, glow: f32, dye: bool, blend: f32)\r\nstruct ClayPart(id: string, order: i32)\r\nMudModel {}\r\n"
    },
    {
      "path": "PoseSchema",
      "code": "// Live command and measured scene result. Separate from authored ClayRest.\r\nstruct PoseOffset(x: f32, y: f32, z: f32, rx: f32, ry: f32, rz: f32)\r\nstruct PoseObserved(x: f32, y: f32, z: f32, rx: f32, ry: f32, rz: f32, sx: f32, sy: f32, sz: f32, lx: f32, ly: f32, lz: f32, offsetApplied: bool, frame: u64)\r\n\r\n// Link a behavior-owned pose command entity to an existing view entity.\r\nPoseTarget {}\r\n"
    },
    {
      "path": "EngineSchema",
      "code": "struct EngineCapability(category: string, command: string, result: string, notes: string)\r\nstruct EngineBehavior(source: string)\r\nstruct PersistState(components: string)\r\nstruct EngineHealth(sources: i32, models: i32, behaviors: i32, adapterErrors: i32, binaryReads: u64, binaryWrites: u64, cachedQueries: u64)\r\nstruct AdapterFault(message: string)\r\nEngineTelemetry { EngineHealth: {0,0,0,0,0,0,0} }\r\nPersistent {}\r\nBoundCapability {}\r\nCapabilities {\r\n    Model { BoundCapability; EngineCapability: {\"model\", \"MudModel root; children with ClayPart id/order, ClayRest and ClayStyle\", \"live MudBun hierarchy; query reflected types\", \"Up to 64 nodes per model; explicit parent-local rest transforms. Use PoseOffset for animation.\"} }\r\n    Motor { BoundCapability; EngineCapability: {\"motion\", \"Per actor ActorControl, MotorPolicy; independent input/goal/command entities returned by inspect_experience\", \"ActorMotion actual position, velocity and grounding\", \"Unity is sole collision solver. Controlled ground/spatial motion; no vehicle dynamics, aerodynamics or pathfinding.\"} }\r\n    Pose { BoundCapability; EngineCapability: {\"animation\", \"Behavior-owned PoseOffset command entities linked through (PoseTarget, target)\", \"PoseObserved actual world/local transforms and applied frame\", \"Additive after Legs/Leaning/Boing, before MudBun. No collider motion. Remove commands to remove effects.\"} }\r\n    Input { BoundCapability; EngineCapability: {\"input\", \"Native on.press/release/click/activate/enter/leave/key_down/key_up; target is resolved by Unity picking\", \"Async template mut state and ordinary reactive ECS output\", \"UI consumes pointer input first; only selected actor reads movement devices. Each model can have independent NPC rules.\"} }\r\n    Behavior { BoundCapability; EngineCapability: {\"logic\", \"Named managed source modules; runtime templates, inheritance/interfaces, expressions, async/await\", \"Reflected ECS data and relationships\", \"No runtime C++ compilation. New native algorithms/plugins need bindings. Template prop changes restart async blocks.\"} }\r\n    Persistence { BoundCapability; EngineCapability: {\"storage\", \"save_experience/load_experience; source edits via edit_source and undo_source\", \"Versioned local experience document\", \"Saves managed source, model configurations, motor position, input state and selected Persistent/ PersistState components including template mut. Pending awaits restart; no mid-instruction VM snapshot.\"} }\r\n}\r\n"
    },
    {
      "path": "RuntimeLibrary",
      "code": "using flecs.script\r\n// Reusable, runtime-interpreted building block; AI can define additional templates.\r\ntemplate TogglePose {\r\n    prop listener: entity\r\n    prop target: entity\r\n    prop degrees: f32 = 20\r\n    mut active = false\r\n    command {\r\n        (PoseTarget, target)\r\n        if active { PoseOffset: {0,0,0,0,0,degrees} }\r\n        else { PoseOffset: {0,0,0,0,0,0} }\r\n    }\r\n    async {\r\n        while true {\r\n            await on.activate(listener)\r\n            active = !active\r\n        }\r\n    }\r\n}\r\n"
    },
