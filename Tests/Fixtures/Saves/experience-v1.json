      "code": "Alpha {\nMudModel\nClayRest: {0, 0.75, -1, 0, 0, 0, 1, 1, 1}\npart_hips {\nClayPart: {\"hips\",0}\nClayRest: {0, 0.65, 0, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_torso {\nClayPart: {\"torso\",0}\nClayRest: {0, 0.15, 0, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_body {\nClayPart: {\"body\",0}\nClayRest: {0, 0, 0, 0, 0, 0, 1.1, 0.7, 0.8}\nClayStyle: {0, 0.2, 0.65, 0.8, 0, 0.45, 0, false, 0.07}\n}\npart_head {\nClayPart: {\"head\",1}\nClayRest: {0, 0.35, -0.15, 0, 0, 0, 0.65, 0.55, 0.6}\nClayStyle: {0, 0.35, 0.8, 0.85, 0, 0.45, 0, false, 0.07}\n}\npart_ear_base {\nClayPart: {\"ear_base\",2}\nClayRest: {0, 0.55, 0, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_ear_tip {\nClayPart: {\"ear_tip\",0}\nClayRest: {0, 0.4, 0, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_ear_brush {\nClayPart: {\"ear_brush\",0}\nClayRest: {0, 0, 0, 0, 0, 0, 0.2, 0.55, 0.2}\nClayStyle: {0, 0.85, 0.5, 0.3, 0, 0.45, 0, false, 0.07}\n}\n}\n}\n}\npart_left_hip {\nClayPart: {\"left_hip\",1}\nClayRest: {-0.4, -0.12, 0, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_left_thigh {\nClayPart: {\"left_thigh\",0}\nClayRest: {0, -0.13, 0.06, 20.0000038, 0, 0, 0.22, 0.4, 0.24}\nClayStyle: {0, 0.3, 0.7, 0.8, 0, 0.45, 0, false, 0.07}\n}\npart_left_knee {\nClayPart: {\"left_knee\",1}\nClayRest: {0, -0.27, 0.14, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_left_shin {\nClayPart: {\"left_shin\",0}\nClayRest: {0, -0.13, -0.05, 340, 0, 0, 0.18, 0.4, 0.22}\nClayStyle: {0, 0.3, 0.7, 0.8, 0, 0.45, 0, false, 0.07}\n}\npart_left_foot {\nClayPart: {\"left_foot\",1}\nClayRest: {0, -0.27, -0.14, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_left_paw {\nClayPart: {\"left_paw\",0}\nClayRest: {0, -0.02, -0.08, 0, 0, 0, 0.3, 0.2, 0.45}\nClayStyle: {0, 0.2, 0.4, 0.5, 0, 0.45, 0, false, 0.07}\n}\n}\n}\n}\npart_right_hip {\nClayPart: {\"right_hip\",2}\nClayRest: {0.4, -0.12, 0, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_right_thigh {\nClayPart: {\"right_thigh\",0}\nClayRest: {0, -0.13, 0.06, 20.0000038, 0, 0, 0.22, 0.4, 0.24}\nClayStyle: {0, 0.3, 0.7, 0.8, 0, 0.45, 0, false, 0.07}\n}\npart_right_knee {\nClayPart: {\"right_knee\",1}\nClayRest: {0, -0.27, 0.14, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_right_shin {\nClayPart: {\"right_shin\",0}\nClayRest: {0, -0.13, -0.05, 340, 0, 0, 0.18, 0.4, 0.22}\nClayStyle: {0, 0.3, 0.7, 0.8, 0, 0.45, 0, false, 0.07}\n}\npart_right_foot {\nClayPart: {\"right_foot\",1}\nClayRest: {0, -0.27, -0.14, 0, 0, 0, 1, 1, 1}\nClayStyle: {2, 0, 0, 0, 0, 0.45, 0, false, 0.07}\npart_right_paw {\nClayPart: {\"right_paw\",0}\nClayRest: {0, -0.02, -0.08, 0, 0, 0, 0.3, 0.2, 0.45}\nClayStyle: {0, 0.2, 0.4, 0.5, 0, 0.45, 0, false, 0.07}\n}\n}\n}\n}\n}\n}\n"
