      "path": "ActorSetupAlpha",
      "code": "Alpha {\nActorControl: {0,2,8}\nMotorPolicy: {false,1}\nActorRig: {\"\\{\\\"driver\\\":\\\"idle\\\",\\\"speed\\\":2,\\\"acceleration\\\":8,\\\"hips\\\":\\\"hips\\\",\\\"legs\\\":[[\\\"left_hip\\\",\\\"left_knee\\\",\\\"left_foot\\\"],[\\\"right_hip\\\",\\\"right_knee\\\",\\\"right_foot\\\"]],\\\"lean\\\":\\\"torso\\\",\\\"boing\\\":[\\\"ear_base\\\"],\\\"spawn\\\":[-2,0,0],\\\"facingYaw\\\":180,\\\"motion\\\":\\\"ground\\\",\\\"gravityScale\\\":1}\"}\nActorMotion: {-2,0,0,0,0,0,0,false}\nMoveIntent: {0,0}\nSpatialIntent: {0,0,0}\n}\n"
    },
    {
      "path": "MotorLibrary",
      "code": "// One template instance per actor. Adapters only execute its motor intent.\r\nusing flecs.script.math\r\ntemplate RuntimeMotorDriver {\r\nprop input: entity\r\nprop goal: entity\r\nprop command: entity\r\nconst mode = this[ActorControl].mode\r\nif mode == 0 {\r\n    MoveIntent: {0,0}; SpatialIntent: {0,0,0}\r\n} else if mode == 1 {\r\n    const stick = input[PlayerMotion]\r\n    const lift = input[LiftIntent].y\r\n    MoveIntent: {stick.x,stick.z}; SpatialIntent: {stick.x,lift,stick.z}\r\n} else if mode == 2 {\r\n    const p = this[ActorMotion]\r\n    const destination = goal[MoveGoal]\r\n    const dx = destination.x - p.x\r\n    const dz = destination.z - p.z\r\n    const distance = sqrt(dx * dx + dz * dz)\r\n    if distance > destination.stopDistance {\r\n        MoveIntent: {dx / distance,dz / distance}; SpatialIntent: {dx / distance,0,dz / distance}\r\n    } else {\r\n        MoveIntent: {0,0}; SpatialIntent: {0,0,0}\r\n    }\r\n} else if mode == 3 {\r\n    const spatial = this[MotorPolicy].spatial\r\n    if spatial {\r\n        const custom = command[SpatialIntent]\r\n        MoveIntent: {custom.x,custom.z}; SpatialIntent: {custom.x,custom.y,custom.z}\r\n    } else {\r\n        const custom = command[MoveIntent]\r\n        MoveIntent: {custom.x,custom.z}; SpatialIntent: {custom.x,0,custom.z}\r\n    }\r\n}\r\n}\r\n"
    },
    {
      "path": "Drivers.Alpha",
      "code": "Alpha { RuntimeMotorDriver: {AlphaInput,AlphaGoal,AlphaCommand} }"
    },
