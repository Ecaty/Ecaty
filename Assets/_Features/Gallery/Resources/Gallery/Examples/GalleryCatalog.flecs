// Disposable gallery fixtures and shared native gallery contracts. No furniture presenter.
using flecs.script.math

struct GalleryEntry(order: i32, width: i32, depth: i32, kind: i32, active: bool)
// Width/depth above describe fixture geometry only. Every world uses one gallery cell.
struct GalleryCell(units: i32)
struct GalleryView(x: f32, y: f32, z: f32, yaw: f32, pitch: f32, zoom: f32, columns: i32)
struct GalleryMotion(time: f32, wave: f32)
struct GalleryFocus(preview: string, current: string, target: i32, visit: i32, inside: bool, following: bool)
struct GallerySample(time: f32)
struct GalleryResidence(elapsed: f32, started: f32, target: i32)
struct GalleryTrack(x: f32, y: f32, z: f32)
struct GalleryProjection(orthographic: bool)
struct GalleryApproach(threshold: f32, measured: f32, armed: bool)
struct GalleryEntryRequest(ready: bool)

GallerySettings { GalleryApproach: {0.4, 10, false} }
GalleryAnimation { GalleryMotion: {Clock[Clock].time, sin(Clock[Clock].time * 1.8)} }
GalleryAquarium { GalleryEntry: {0, 3, 1, 0, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 4.7, 6} }
GallerySpace { GalleryEntry: {1, 2, 1, 1, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 3.8, 6} }
GalleryGarden { GalleryEntry: {2, 1, 1, 2, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 2.9, 6} }
GalleryRain { GalleryEntry: {3, 2, 1, 3, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 3.8, 6} }
GalleryMarch { GalleryEntry: {4, 2, 1, 4, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 3.8, 6} }
GalleryMusic { GalleryEntry: {5, 1, 1, 5, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 2.9, 6} }
GalleryOcean { GalleryEntry: {6, 2, 1, 6, true}; GalleryCell: {1}; GalleryProjection: {false}; GallerySample: {0}; GalleryResidence: {0, 0, 0}; GalleryTrack: {0, 0, 0}; GalleryView: {0, 0.5, 0, 0, 23, 3.8, 6} }
