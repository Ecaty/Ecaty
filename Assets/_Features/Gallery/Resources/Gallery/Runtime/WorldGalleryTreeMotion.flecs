using flecs.script.math
// Tree clock and ring turns are compiled native systems (Native/App). Event-driven derived state stays here.

GalleryTreeSettings {
    GalleryReturnState: {
        GalleryTreeSettings[GalleryReturnIntent].started,
        min(1, max(0, (Clock[Clock].time - GalleryTreeSettings[GalleryReturnIntent].started) / GalleryTreeSettings[GalleryReturnStyle].seconds)),
        min(1, max(0, (Clock[Clock].time - GalleryTreeSettings[GalleryReturnIntent].started - 0.12) / GalleryTreeSettings[GalleryReturnStyle].revealSeconds))
    }
}

GalleryTreeSettings {
    GalleryGlassState: {GalleryTreeSettings[GalleryGlassIntent].started, min(1, max(0, (Clock[Clock].time - GalleryTreeSettings[GalleryGlassIntent].started) / GalleryTreeSettings[GalleryReturnStyle].glassSeconds))}
    GalleryRecenterState: {min(1, max(0,
        (1 / max(0.08, GalleryTreeSettings[GalleryCameraMeasure].zoom) - 1 / max(0.08, GalleryTreeSettings[GalleryCameraAnchor].zoom)) /
        max(0.00001, 1 / max(0.08, GalleryTreeSettings[GalleryCameraAnchor].minimum) - 1 / max(0.08, GalleryTreeSettings[GalleryCameraAnchor].zoom))
    ))}
}
