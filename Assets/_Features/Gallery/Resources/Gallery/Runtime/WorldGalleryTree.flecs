using flecs.script.math
// GalleryTreeActivity, GalleryTreeMotion, GalleryLayerIntent, GalleryLayerState, GalleryEntry, GalleryPlacement and the GalleryOnLayer relationship are native (Native/App).
struct GalleryTreeConfig(diameter: f32, worldGap: f32, layerGap: f32, width: f32, opacity: f32, sphereOpacity: f32, rim: f32, frost: f32, rearFade: f32, speed: f32, response: f32, style: i32, feather: f32)
struct GalleryDrag(source: string, target: string, active: bool)
struct GalleryVisibility(covered: f32, opacity: f32, pickable: bool)
struct GalleryPortal(world: string)
// Request to enter a world by id (scripts, AI tools, store screenshots). The gallery clears it after acting.
struct GalleryEnterIntent(world: string)
struct GalleryTreeNavigation(approach: bool, returning: bool, exitArmed: bool, exitIdle: bool, exitAt: f32, boundary: f32, target: string, exitPull: f32, entryDistance: f32, portalReturn: bool, portalAt: f32)
struct GalleryReturnStyle(seconds: f32, revealSeconds: f32, glassSeconds: f32)
struct GalleryReturnIntent(active: bool, started: f32, world: string, x: f32, y: f32, z: f32, radius: f32)
struct GalleryReturnState(epoch: f32, progress: f32, reveal: f32)
struct GalleryCameraAnchor(active: bool, x: f32, y: f32, z: f32, zoom: f32, minimum: f32, centerY: f32)
struct GalleryCameraMeasure(zoom: f32)
struct GalleryRecenterState(weight: f32)
struct GalleryGlassIntent(started: f32, entering: bool)
struct GalleryGlassState(epoch: f32, progress: f32)
// document: the world as a format 2 document; state: capability adapter state (JSON) for the bindings in it.
struct GallerySavedWorld(format: i32, document: string, selected: string, revision: i32, state: string)
