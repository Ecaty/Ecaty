using flecs.script
using flecs.script.math

struct WorkshopSeedRequest(count: i32)

template WorkshopSeedIdle {
    prop anchor: entity
    mut requests = 0

    const origin = anchor[Position]
    const t = Clock[Clock].time
    Position: {origin.x, origin.y + 0.06 * sin(t * 2), origin.z}
    Rotation: {5 + 4 * sin(t * 0.8), 6 * t, -9 + 3 * sin(t * 0.65)}
    WorkshopSeedRequest: {requests}

    async {
        while true {
            await on.activate(anchor)
            requests = requests + 1
        }
    }
}

WorkshopSeedIdle WorkshopSeedMotion(anchor: WorldSeed) {}
